diff -ruN a/cc/private/toolchain/gcc_deps_scanner_wrapper.sh.tpl b/cc/private/toolchain/gcc_deps_scanner_wrapper.sh.tpl
--- a/cc/private/toolchain/gcc_deps_scanner_wrapper.sh.tpl	2026-09-05 00:46:30.252229300 +0800
+++ b/cc/private/toolchain/gcc_deps_scanner_wrapper.sh.tpl	2026-09-05 00:48:14.206583200 +0800
@@ -9,4 +9,23 @@
 
 # Call the C++ compiler
 
-%{cc} -E -x c++ -fmodules-ts -fdeps-file=out.tmp -fdeps-format=p1689r5 "$@" >"$DEPS_SCANNER_OUTPUT_FILE"
+# GCC writes the p1689 dependency JSON to -fdeps-file, not to stdout, and
+# Bazel passes "-o <ddi>" (plus -MD) expecting the JSON there; hand that
+# path to -fdeps-file instead and send the preprocessed text to /dev/null.
+out=""
+args=()
+wants_dotd=0
+while [ $# -gt 0 ]; do
+  case "$1" in
+    -o) out="$2"; shift 2 ;;
+    -MD|-MMD) wants_dotd=1; args+=("$1"); shift ;;
+    *) args+=("$1"); shift ;;
+  esac
+done
+if [ -z "$out" ]; then
+  out="$DEPS_SCANNER_OUTPUT_FILE"
+fi
+if [ "$wants_dotd" = 1 ]; then
+  args+=(-MF "$out.d")
+fi
+%{cc} -E -x c++ -fmodules-ts -fdeps-format=p1689r5   -fdeps-file="$out" -fdeps-target="$out" "${args[@]}" -o /dev/null
diff -ruN a/cc/private/toolchain/linux_cc_wrapper.sh.tpl b/cc/private/toolchain/linux_cc_wrapper.sh.tpl
--- a/cc/private/toolchain/linux_cc_wrapper.sh.tpl	2026-09-05 00:53:28.390206000 +0800
+++ b/cc/private/toolchain/linux_cc_wrapper.sh.tpl	2026-09-05 00:56:45.410671900 +0800
@@ -19,18 +19,25 @@
 set -eu
 
 OUTPUT=
+DEPFILE=
+MODULES=
 
 parse_option() {
     opt=$1
     if [ "$OUTPUT" = "1" ]; then
         OUTPUT=$opt
+    elif [ "$DEPFILE" = "1" ]; then
+        DEPFILE=$opt
     elif [ "$opt" = "-o" ]; then
         # output is coming
         OUTPUT=1
+    elif [ "$opt" = "-MF" ]; then
+        DEPFILE=1
+    elif [ "$opt" = "-fmodules-ts" ] || [ "$opt" = "-fmodules" ]; then
+        MODULES=1
     fi
 }
 
-# parse the option list
 for i in "$@"; do
     case $i in
         @*)
@@ -47,13 +54,29 @@
     esac
 done
 
-# Set-up the environment
 %{env}
 
-# Call the C++ compiler
 %{cc} "$@"
 
-# Generate an empty file if header processing succeeded.
+# With modules enabled GCC names the CMI as a second target of the object's
+# rule ("x.o x.pcm: deps", the target list may wrap) and appends rules for it
+# ("x.pcm:| x.o", "name.c++-module: x.pcm", ".PHONY: ..."). Bazel treats every
+# token in the .d as an inclusion and rejects the CMI as undeclared, so keep
+# only the first rule and rewrite its target list to the object file.
+if [ "$MODULES" = "1" ] && [ -n "$DEPFILE" ] && [ "$DEPFILE" != "1" ] && [ -f "$DEPFILE" ]; then
+    awk -v obj="$OUTPUT" '
+        !done {
+            rule = rule $0 "\n"
+            if ($0 !~ /\\$/) {
+                done = 1
+                sub(/^[^:]*:/, obj ":", rule)
+                printf "%s", rule
+            }
+            next
+        }
+        { exit }' "$DEPFILE" > "$DEPFILE.tmp" && mv -f "$DEPFILE.tmp" "$DEPFILE"
+fi
+
 case $OUTPUT in
     *.h.processed)
         : > "$OUTPUT"
