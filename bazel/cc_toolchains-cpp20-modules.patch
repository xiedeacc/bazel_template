diff --git a/toolchain/cc_wrapper.sh.tpl b/toolchain/cc_wrapper.sh.tpl
index ee8ebea..ab2a9d3 100644
--- a/toolchain/cc_wrapper.sh.tpl
+++ b/toolchain/cc_wrapper.sh.tpl
@@ -48,5 +48,36 @@ for ((i = 0; i <= $#; i++)); do
   fi
 done
 
+# Find the flags that decide whether the .d file needs post-processing.
+output=""
+depfile=""
+modules=""
+for ((i = 0; i < ${#cmd[@]}; i++)); do
+  case "${cmd[i]}" in
+  -o) output="${cmd[i + 1]:-}" ;;
+  -MF) depfile="${cmd[i + 1]:-}" ;;
+  -fmodules-ts | -fmodules) modules=1 ;;
+  esac
+done
+
 # Call the C++ compiler.
-exec "${cmd[@]}"
+"${cmd[@]}"
+
+# With modules enabled GCC names the CMI as a second target of the object's
+# rule ("x.o x.pcm: deps", the target list may wrap) and appends rules for it
+# ("x.pcm:| x.o", "name.c++-module: x.pcm", ".PHONY: ..."). Bazel treats every
+# token in the .d as an inclusion and rejects the CMI as undeclared, so keep
+# only the first rule and rewrite its target list to the object file.
+if [[ -n ${modules} && -n ${depfile} && -n ${output} && -f ${depfile} ]]; then
+  awk -v obj="${output}" '
+    !finished {
+      rule = rule $0 "\n"
+      if ($0 !~ /\\$/) {
+        finished = 1
+        sub(/^[^:]*:/, obj ":", rule)
+        printf "%s", rule
+      }
+      next
+    }
+    { exit }' "${depfile}" >"${depfile}.tmp" && mv -f "${depfile}.tmp" "${depfile}"
+fi
diff --git a/toolchain/clang_deps_scanner_wrapper.sh.tpl b/toolchain/clang_deps_scanner_wrapper.sh.tpl
new file mode 100644
index 0000000..3931a84
--- /dev/null
+++ b/toolchain/clang_deps_scanner_wrapper.sh.tpl
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+#
+# C++20 named module dependency scanner for Clang.
+#
+set -eu
+
+scanner="%{deps_scanner}"
+if [ ! -x "$scanner" ]; then
+  echo >&2 "ERROR: clang-scan-deps not found at \"$scanner\"."
+  echo >&2 "The Clang toolchain archive for this target does not ship"
+  echo >&2 "clang-scan-deps, so C++20 named modules cannot be scanned."
+  exit 1
+fi
+
+exec "$scanner" -format=p1689 -- "%{cc}" "$@" >"$DEPS_SCANNER_OUTPUT_FILE"
diff --git a/toolchain/gcc_deps_scanner_wrapper.sh.tpl b/toolchain/gcc_deps_scanner_wrapper.sh.tpl
new file mode 100644
index 0000000..0c10344
--- /dev/null
+++ b/toolchain/gcc_deps_scanner_wrapper.sh.tpl
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+#
+# C++20 named module dependency scanner for GCC.
+#
+set -eu
+
+# GCC writes the p1689 dependency JSON to -fdeps-file, not to stdout, while
+# Bazel passes "-o <ddi>" (and possibly -MD) expecting the JSON at <ddi>; hand
+# that path to -fdeps-file instead and send the preprocessed text to /dev/null.
+out=""
+args=()
+wants_dotd=0
+while [ $# -gt 0 ]; do
+  case "$1" in
+    -o) out="$2"; shift 2 ;;
+    -MD|-MMD) wants_dotd=1; args+=("$1"); shift ;;
+    *) args+=("$1"); shift ;;
+  esac
+done
+if [ -z "$out" ]; then
+  out="${DEPS_SCANNER_OUTPUT_FILE:-}"
+fi
+if [ -z "$out" ]; then
+  echo >&2 "ERROR: no -o and no DEPS_SCANNER_OUTPUT_FILE for the deps scan."
+  exit 1
+fi
+if [ "$wants_dotd" = 1 ]; then
+  args+=(-MF "$out.d")
+fi
+
+exec "%{cc}" -E -x c++ -fmodules-ts -fdeps-format=p1689r5 \
+  -fdeps-file="$out" -fdeps-target="$out" "${args[@]}" -o /dev/null
