# class defined in a function template (C2597, illegal reference to non-static
# member 'BasePatchVisitor::typeRef'). Qualifying it with this-> is what the
# standard wants anyway. Applies on top of fbthrift.patch.
--- a/thrift/lib/cpp2/util/DebugTree.cpp
+++ b/thrift/lib/cpp2/util/DebugTree.cpp
@@ -551,7 +551,7 @@
     const protocol::DynamicListPatch& patch, const OptionalTypeRef& listType) {
   struct Visitor : BasePatchVisitor {
     void push_back(const protocol::Value& v) {
-      addOp("push_back", debugTree(v, getListElem(typeRef)));
+      addOp("push_back", debugTree(v, getListElem(this->typeRef)));
     }
   };
 
@@ -586,7 +586,7 @@
       if (set.empty()) {
