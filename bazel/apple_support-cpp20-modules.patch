@@ -147,6 +147,41 @@
 def _copy_file(repository_ctx, src, dest):
     repository_ctx.file(dest, content = repository_ctx.read(src))
 
+def _find_deps_scanner(repository_ctx):
+    """Finds clang-scan-deps, which drives C++20 named module dependency scanning.
+
+    Xcode's toolchain does not ship clang-scan-deps, so fall back to whatever
+    is on PATH and finally to a Homebrew LLVM install.
+
+    Args:
+      repository_ctx: The repository context.
+    Returns:
+      A path to clang-scan-deps, or the bare tool name if none was found.
+    """
+
+    override = repository_ctx.os.environ.get("BAZEL_CLANG_SCAN_DEPS")
+    if override:
+        return override
+
+    result = repository_ctx.execute(["/usr/bin/xcrun", "--find", "clang-scan-deps"])
+    if result.return_code == 0 and result.stdout.strip():
+        return result.stdout.strip()
+
+    on_path = repository_ctx.which("clang-scan-deps")
+    if on_path:
+        return str(on_path)
+
+    result = repository_ctx.execute([
+        "/bin/sh",
+        "-c",
+        "ls -1 /opt/homebrew/opt/llvm*/bin/clang-scan-deps " +
+        "/usr/local/opt/llvm*/bin/clang-scan-deps 2>/dev/null | head -n 1",
+    ])
+    if result.return_code == 0 and result.stdout.strip():
+        return result.stdout.strip()
+
+    return "clang-scan-deps"
+
 def configure_osx_toolchain(repository_ctx):
     """Configure C++ toolchain on macOS.
 
