diff -ruN a/crosstool/cc_module_deps_scanner.sh.tpl b/crosstool/cc_module_deps_scanner.sh.tpl
--- a/crosstool/cc_module_deps_scanner.sh.tpl	1970-01-01 08:00:00.000000000 +0800
+++ b/crosstool/cc_module_deps_scanner.sh.tpl	2026-09-05 01:05:30.083956200 +0800
@@ -0,0 +1,59 @@
+#!/bin/bash
+#
+# C++20 named module dependency scanner for the Apple CC toolchain.
+#
+# Bazel drives this action with the same command line it would hand to a C++
+# compile, so the arguments still contain the placeholders that wrapped_clang
+# normally expands and may be wrapped in a params file. Expand both here, then
+# let clang-scan-deps emit the P1689 dependency JSON on stdout and redirect it
+# to the file Bazel expects.
+
+set -eu
+
+developer_dir="${DEVELOPER_DIR:-}"
+if [[ -z "${developer_dir}" ]]; then
+  developer_dir="$(/usr/bin/xcode-select -p)"
+fi
+
+sdkroot="${SDKROOT:-}"
+if [[ -z "${sdkroot}" ]]; then
+  sdkroot="$(/usr/bin/xcrun --show-sdk-path)"
+fi
+
+execution_root="${PWD}"
+
+_expand() {
+  local arg="$1"
+  arg="${arg//__BAZEL_EXECUTION_ROOT_CANONICAL__/${execution_root}}"
+  arg="${arg//__BAZEL_EXECUTION_ROOT__/${execution_root}}"
+  arg="${arg//__BAZEL_XCODE_DEVELOPER_DIR__/${developer_dir}}"
+  arg="${arg//__BAZEL_XCODE_SDKROOT__/${sdkroot}}"
+  printf '%s' "${arg}"
+}
+
+_tmp_files=()
+_cleanup() {
+  if [[ ${#_tmp_files[@]} -gt 0 ]]; then
+    rm -f "${_tmp_files[@]}"
+  fi
+}
+trap _cleanup EXIT
+
+args=()
+for arg in "$@"; do
+  if [[ "${arg}" == @* && -f "${arg:1}" ]]; then
+    params="$(mktemp "${TMPDIR:-/tmp}/apple_cc_scan_deps_params.XXXXXX")"
+    _tmp_files+=("${params}")
+    while IFS= read -r line; do
+      _expand "${line}" >>"${params}"
+      printf '\n' >>"${params}"
+    done <"${arg:1}"
+    args+=("@${params}")
+  else
+    args+=("$(_expand "${arg}")")
+  fi
+done
+
+compiler="$(/usr/bin/xcrun --find clang++)"
+
+"%{deps_scanner}" -format=p1689 -- "${compiler}" "${args[@]}" >"${DEPS_SCANNER_OUTPUT_FILE}"
