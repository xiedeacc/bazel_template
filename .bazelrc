build:gcc_aarch64_linux_gnu --java_runtime_version="remotejdk_21"
build:gcc_aarch64_linux_gnu --jobs=6
build:gcc_aarch64_linux_gnu --action_env=LD_LIBRARY_PATH=/root/src/software/toolchains/host-libs
build:gcc_aarch64_linux_gnu --copt='-g'
build:gcc_aarch64_linux_gnu --host_copt='-g'

