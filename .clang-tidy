---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  google-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-vararg,
  -google-readability-todo,
  -modernize-use-trailing-return-type,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers,
  # Rewrites sink parameters to by-value + std::move. That is the right
  # shape for constructors and setters that store the value, and a
  # pessimisation for read-only parameters or types whose move is not
  # cheap, so it is a judgement call per call site rather than a rule.
  -modernize-pass-by-value
WarningsAsErrors: ''
HeaderFilterRegex: '(src|test_data).'
ExcludeHeaderFilterRegex: '(external|bazel-out|_virtual_includes).'
FormatStyle: file
CheckOptions:
  - key: bugprone-argument-comment.StrictMode
    value: '0'
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
...
