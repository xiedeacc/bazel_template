# clang-tidy 22 (VS 2026) treats a two-line "-iquote" + "<dir>" pair in the
# --config param file as an input file; emit the joined form instead.
single_version_override(
    module_name = "aspect_rules_lint",
    patch_strip = 1,
    patches = ["//bazel:rules_lint-clang22-joined-includes.patch"],
    version = "2.8.0",
)
