        "//bazel:protobuf-musl-path-max.patch",
        "//bazel:protobuf-cxx-modules-arm-varint.patch",
    ],
    version = "35.1",
)

# rules_cc 0.2.22 C++20 module fixes: the MSVC toolchain never exports DEPS_SCANNER_OUTPUT_FILE
# to the C++20 module deps-scanning action, so its wrapper cannot redirect
# cl.exe's output and every scan fails.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = ["//bazel:rules_cc-cpp20-modules.patch"],
    version = "0.2.22",
)

# The cc_toolchains fork of unix_cc_toolchain_config.bzl predates C++20 named
# module support, so the cross toolchains have no deps-scanning, module compile
# or modmap actions. The patch ports them from rules_cc 0.2.22 and adds the
# per-toolchain p1689 deps scanner wrapper they need.
# apple_support 2.7.0 has no C++20 named module support at all: its crosstool
# knows nothing about the deps-scanning, module-compile and module-codegen
# actions, so --experimental_cpp_modules cannot work on macOS. The patch adds
# them, plus a generated clang-scan-deps wrapper.
single_version_override(
    module_name = "apple_support",
    patch_strip = 1,
    patches = ["//bazel:apple_support-cpp20-modules.patch"],
    version = "2.7.0",
)

git_override(
    commit = "053ccff396d7f2a3be29b8e426d8c6df081d8221",
    module_name = "cc_toolchains",
    patch_strip = 1,
    patches = ["//bazel:cc_toolchains-cpp20-modules.patch"],
    remote = "https://github.com/xiedeacc/cc_toolchains.git",
)

git_override(
    commit = "c4d35e0d0b838309358e57a2efed831780f85cd0",
    module_name = "bazel_clang_tidy",
    remote = "https://github.com/erenon/bazel_clang_tidy.git",
)

single_version_override(
    module_name = "snappy",
    patch_strip = 1,
    patches = ["//bazel:snappy.patch"],
    version = "1.2.2.bcr.3",
)

