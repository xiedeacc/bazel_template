maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "net.java.dev.jna:jna:5.14.0",
        "com.google.truth:truth:0.32",
        "org.junit.platform:junit-platform-launcher:1.9.2",
        "org.junit.platform:junit-platform-reporting:1.9.2",
        "org.junit.jupiter:junit-jupiter-api:5.9.2",
        "org.junit.jupiter:junit-jupiter-params:5.9.2",
        "org.junit.jupiter:junit-jupiter-engine:5.9.2",
    ],
    repositories = [
        # Aliyun mirrors Maven Central and is an order of magnitude faster from
        # here; repo1 stays as a fallback in case the mirror lacks an artifact.
        "https://maven.aliyun.com/repository/public",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

gen_local_config_git(name = "local_config_git")

register_toolchains(
    "@openssl//:preinstalled_make_toolchain",
    "@openssl//:preinstalled_pkgconfig_toolchain",
)

# rules_cc's autoconfigured toolchain wins toolchain resolution on macOS unless
# the root module registers apple_support's, and that one has no C++20 named
# module support (and points at a clang-scan-deps Xcode does not ship).
apple_cc_configure = use_extension("@build_bazel_apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_cc_configure, "local_config_apple_cc_toolchains")

register_toolchains("@local_config_apple_cc_toolchains//:all")

cc_toolchains = use_extension("//bazel:toolchains_extension.bzl", "cc_toolchains_extension")
use_repo(
    cc_toolchains,
    "cc_toolchain_config_clang_aarch64_generic_linux_glibc",
    "cc_toolchain_config_clang_aarch64_generic_linux_musl",
    "cc_toolchain_config_clang_x86_64_generic_linux_glibc",
    "cc_toolchain_config_clang_x86_64_generic_linux_musl",
